# Paws & Walks Environment Configuration
# Copy this file to .env and fill in your actual values

# =====================================================
# Django Configuration
# =====================================================
# Secret key for Django (generate a new one for production)
SECRET_KEY=django-insecure-bpa1-)o^&@*gfqscdan0ck1!vbu&e=3v=zqp9-kmgt^o2h0q#h

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts for Django (comma-separated for production)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# =====================================================
# Database Configuration
# =====================================================
# SQLite (local development)
# DATABASE_URL=

# PostgreSQL (Docker / Production)
DATABASE_URL=postgresql://postgres:postgres@db:5432/pawswalks

# =====================================================
# Microservices
# =====================================================
# Flask Disponibilidad microservice URL
# Leave empty to use Django's internal fallback service
DISPONIBILIDAD_SERVICE_URL=http://disponibilidad:5001

# Flask Ratings microservice URL (future integration)
# RATINGS_SERVICE_URL=http://ratings:5000

# =====================================================
# External APIs
# =====================================================
# OpenWeather API key (get free key from https://openweathermap.org/api)
# Leave empty to use mock weather data
OPENWEATHER_API_KEY=

# =====================================================
# Message Broker (Redis/Celery)
# =====================================================
# Redis connection string for Celery task broker
CELERY_BROKER_URL=redis://redis:6379/0

# =====================================================
# Notifications
# =====================================================
# Notificador type: MOCK (console) | REAL (email)
ENV_TYPE=MOCK

# =====================================================
# Django Internationalization
# =====================================================
# Language code
LANGUAGE_CODE=es

# Timezone
TIME_ZONE=America/Bogota

# =====================================================
# Email Configuration (required if ENV_TYPE=REAL)
# =====================================================
# Email backend (for production use: django.core.mail.backends.smtp.EmailBackend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# =====================================================
# AWS Configuration (future deployment)
# =====================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
